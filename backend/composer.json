{
  "name": "paleocene/palecrm",
  "type": "project",
  "description": "PaleoCRM - Legacy to Modern Refactoring Showcase (PHP 5.6 to 8.3)",
  "license": "MIT",
  "authors": [
    {
      "name": "Your Name",
      "email": "your.email@example.com",
      "role": "Senior Fullstack Developer"
    }
  ],
  "require": {
    "php": ">=8.3.0",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.8"
  },
  "autoload": {
    "psr-4": {
      "PaleoCRM\\": "src/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html=coverage",
    "analyse": "vendor/bin/phpstan analyse src tests",
    "format": "vendor/bin/phpcbf --standard=PSR12 src",
    "lint": "vendor/bin/phpcs --standard=PSR12 src"
  },
  "config": {
    "allow-plugins": true,
    "platform": {
      "php": "8.3.0"
    }
  }
}